static func _make(locale: String, table: Dictionary) -> Translation:
	var t := Translation.new()
	t.locale = locale
	for k in table:
		t.add_message(k, table[k])
	return t


static func build() -> Array:
	var list: Array = [_make("en", EN)]
	list.append(_make("es", ES))
	list.append(_make("de", DE))
	list.append(_make("it", IT))
	list.append(_make("pt", PT))
	return list
